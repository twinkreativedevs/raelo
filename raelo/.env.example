# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only. Bypasses Row Level Security; used for payment confirmation,
# invoices and audit logging. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# Public base URL, used for Paystack callback URLs and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paystack (Dashboard > Settings > API Keys & Webhooks) ---
# Server-only. Use sk_test_... locally and sk_live_... in production.
PAYSTACK_SECRET_KEY=sk_test_xxx

# --- Cron ---
# Shared secret for /api/cron/billing. Vercel Cron sends it automatically.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Email (Resend: resend.com) ---
# Without a key, emails are logged as "skipped" in Admin → Activity log → Messages.
RESEND_API_KEY=
# Fallback sender if Admin → Settings → Email has no from address.
# Must be on a domain verified in Resend.
EMAIL_FROM=hello@yourdomain.com

# --- SMS (Termii: termii.com) ---
TERMII_API_KEY=
# Your account's base URL from the Termii dashboard.
TERMII_BASE_URL=https://api.ng.termii.com

# --- AI assistant (Groq: console.groq.com) ---
# The landing-page chat widget shows only when this is set AND it's enabled
# in Admin → Settings → AI assistant.
GROQ_API_KEY=
