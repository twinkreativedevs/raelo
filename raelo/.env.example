# Copy to .env.local and fill in. Never commit real values.
# Only the first block is required to run the site; everything else can be
# added later (each feature switches itself on when its key is present).

# --- Required -------------------------------------------------------------

# Neon (console.neon.tech → your project → Connect). Use the *pooled*
# connection string (host contains "-pooler") with sslmode=require.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs sign-in sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL: email links, Paystack callbacks, invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the daily job at /api/cron/billing (renewals, reminders).
# Vercel Cron sends it automatically. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- File uploads (Vercel Blob) ---------------------------------------------
# Vercel → Storage → Create → Blob, access **Private**, connect it to the
# project; Vercel adds this for you. Locally, copy it from the store page.
# Without it, logo and content uploads are switched off.
BLOB_READ_WRITE_TOKEN=

# --- Payments (Paystack) ----------------------------------------------------
# Dashboard → Settings → API Keys & Webhooks. sk_test_… first, sk_live_… to
# go live. Without it, checkout shows "online payment opens soon" and admins
# can still give clients free plans.
PAYSTACK_SECRET_KEY=

# --- Email (Resend: resend.com) ----------------------------------------------
# Without a key: sign-up doesn't ask for email confirmation, invite links are
# shown to the admin instead of emailed, and other emails are logged as
# "skipped" in Admin → Activity log → Messages.
RESEND_API_KEY=
# Fallback sender if Admin → Settings → Email has no from address.
# Must be on a domain verified in Resend.
EMAIL_FROM=hello@yourdomain.com

# --- SMS (Termii: termii.com) -------------------------------------------------
TERMII_API_KEY=
# Your account's base URL from the Termii dashboard.
TERMII_BASE_URL=https://api.ng.termii.com

# --- AI assistant (Groq: console.groq.com) ------------------------------------
# The landing-page chat widget shows only when this is set AND it's enabled
# in Admin → Settings → AI assistant.
GROQ_API_KEY=
